name: data_split
conda_env: conda.yml

entry_points:
  main:
    parameters:
      input_artifact:
        description: Input CSV to split
        type: string
      test_size:
        description: Fraction for test split
        type: float
      val_size:
        description: Fraction for validation split (from renaming after test)
        type: float
      random_seed:
        description: Random seed
        type: int
      stratify_by:
        description: Column name to stratify by (use "none" for no stratification)
        type: string
      trainval_artifact:
        description: Output artifact name for train+val set
        type: string
      test_artifact:
        description: output artifact name for test set
        type: string
    
    command: "python run.py --input_artifact {input_artifact} --test_size {test_size} --val_size {val_size} --random_seed {random_seed} --stratify_by {stratify_by} --trainval_artifact {trainval_artifact} --test_artifact {test_artifact}"